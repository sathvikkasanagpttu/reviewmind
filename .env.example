# ---- Server only. Never expose these to the browser / Vite bundle. ----

# Supabase (canonical ledger for ownership, approval, history)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe (publishable) Supabase key, exposed via apps/web/.env as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=

# Hindsight (persistent memory: retain / recall / reflect)
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
# "memory" (real Hindsight Cloud client) or "inmemory" (deterministic local mock for offline dev/demo)
MEMORY_ADAPTER=inmemory

# LLM provider (one configured provider only, per PRD)
LLM_BASE_URL=https://api.anthropic.com/v1/messages
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# "llm" (real provider call) or "rulebased" (deterministic offline generator used for demo/dev without a key)
REVIEWER_PROVIDER=rulebased

APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
PORT=8787
